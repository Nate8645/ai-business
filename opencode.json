{
  "$schema": "https://opencode.ai/config.json",
  "team": {
    "name": "aibusiness",
    "config": "ai-team/TEAM.md",
    "active": true,
    "admin": ["Windows Use", "OpenCode", "Claude Code"]
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
